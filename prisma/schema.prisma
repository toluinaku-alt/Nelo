// Nelo Delivery Platform — Prisma Schema
// Configured with SQLite for zero-setup local development and testable out-of-the-box.
// For Supabase PostgreSQL production, see prisma/schema.supabase.prisma and supabase/migrations/

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  fullName     String
  phone        String?
  role         String        @default("CUSTOMER") // CUSTOMER, VENDOR_OWNER, VENDOR_STAFF, RIDER, DISPATCHER, SUPPORT_AGENT, FINANCE_OPERATOR, ADMIN
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  addresses    CustomerAddress[]
  orders       Order[]       @relation("CustomerOrders")
  riderProfile RiderProfile?
  vendorStaff  VendorStaff[]
  supportCases SupportCase[] @relation("CreatedSupportCases")
  assignedCases SupportCase[] @relation("AssignedSupportCases")
  auditLogs    AuditLog[]
  ratingsGiven Rating[]      @relation("RatingsGiven")

  @@index([role])
}

model CustomerAddress {
  id                   String   @id @default(uuid())
  userId               String
  label                String   // e.g. "Home", "Office", "Balogun Market"
  streetAddress        String
  city                 String   @default("Lagos")
  state                String   @default("Lagos State")
  latitude             Float
  longitude            Float
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ServiceZone {
  id                  String   @id @default(uuid())
  name                String   // e.g. "Lagos Island - VI / Lekki", "Lagos Mainland - Ikeja / Yaba", "Abuja Central"
  state               String   @default("Lagos")
  baseFareKobo        Int      @default(120000) // 1,200 NGN
  perKmRateKobo       Int      @default(15000)  // 150 NGN/km
  surgeMultiplier     Float    @default(1.0)
  maxPackageWeightKg  Float    @default(25.0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  vendors             Vendor[]
  orders              Order[]
}

model Vendor {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  description       String
  category          String            // FOOD, GROCERY
  logoUrl           String?
  bannerUrl         String?
  streetAddress     String
  city              String            @default("Lagos")
  state             String            @default("Lagos State")
  latitude          Float
  longitude         Float
  zoneId            String
  isVerified        Boolean           @default(true)
  isOpen            Boolean           @default(true)
  rating            Float             @default(4.8)
  prepTimeMinutes   Int               @default(25)
  commissionPercent Float             @default(12.5)
  payoutBankCode    String?           // e.g. "058" (GTBank), "044" (Access)
  payoutAccountNum  String?
  payoutAccountName String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  zone              ServiceZone       @relation(fields: [zoneId], references: [id])
  staff             VendorStaff[]
  catalogCategories CatalogCategory[]
  catalogItems      CatalogItem[]
  orders            Order[]
  ratings           Rating[]

  @@index([zoneId])
  @@index([category])
  @@index([isOpen])
}

model VendorStaff {
  id        String   @id @default(uuid())
  vendorId  String
  userId    String
  role      String   @default("MANAGER") // OWNER, MANAGER, KITCHEN_STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
}

model CatalogCategory {
  id        String        @id @default(uuid())
  vendorId  String
  name      String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  vendor    Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items     CatalogItem[]

  @@index([vendorId])
}

model CatalogItem {
  id                     String          @id @default(uuid())
  vendorId               String
  categoryId             String
  name                   String
  description            String?
  priceKobo              Int             // Price in Nigerian Kobo
  imageUrl               String?
  isAvailable            Boolean         @default(true)
  preparationTimeMinutes Int             @default(15)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  vendor                 Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category               CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]

  @@index([vendorId])
  @@index([categoryId])
}

model RiderProfile {
  id                  String          @id @default(uuid())
  userId              String          @unique
  employmentType      String          @default("FREELANCE") // FREELANCE, COMPANY_EMPLOYED
  vehicleType         String          @default("MOTORCYCLE") // MOTORCYCLE, BICYCLE, VAN
  plateNumber         String?
  driversLicense      String?
  isVerified          Boolean         @default(true)
  isOnline            Boolean         @default(false)
  currentLat          Float?
  currentLng          Float?
  lastLocationUpdate  DateTime?
  rating              Float           @default(4.9)
  totalDeliveries     Int             @default(0)
  walletBalanceKobo   Int             @default(0)
  activeZoneId        String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries          Delivery[]
  offers              DispatchOffer[]
  ratingsReceived     Rating[]

  @@index([isOnline])
  @@index([employmentType])
}

model Order {
  id                   String                   @id @default(uuid())
  orderNumber          String                   @unique // e.g. NELO-LG-8291
  customerId           String
  serviceType          String                   // MARKETPLACE, SHOP_FOR_ME, PACKAGE
  status               String                   @default("DRAFT") // DRAFT, QUOTED, AWAITING_PAYMENT, PLACED, VENDOR_ACCEPTED, AWAITING_RIDER, ASSIGNED, PICKED_UP, IN_TRANSIT, DELIVERED, DECLINED, CANCELLED, PAYMENT_FAILED, DELIVERY_EXCEPTION, RETURNED, REFUNDED
  zoneId               String
  vendorId             String?                  // Optional: for MARKETPLACE orders
  currency             String                   @default("NGN")
  subtotalKobo         Int                      @default(0)
  deliveryFeeKobo      Int                      @default(0)
  serviceFeeKobo       Int                      @default(0)
  surgeFeeKobo         Int                      @default(0)
  tipKobo              Int                      @default(0)
  totalAmountKobo      Int                      @default(0)
  pickupAddressJson    String                   // Snapshot: address, coords, contact
  dropoffAddressJson   String                   // Snapshot: address, coords, contact
  cancellationReason   String?
  idempotencyKey       String?                  @unique
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  customer             User                     @relation("CustomerOrders", fields: [customerId], references: [id])
  zone                 ServiceZone              @relation(fields: [zoneId], references: [id])
  vendor               Vendor?                  @relation(fields: [vendorId], references: [id])
  items                OrderItem[]
  marketplaceDetails   MarketplaceOrderDetails?
  shopForMeDetails     ShopForMeDetails?
  packageDetails       PackageDetails?
  delivery             Delivery?
  payment              Payment?
  events               OrderEvent[]
  supportCases         SupportCase[]
  ratings              Rating[]

  @@index([customerId])
  @@index([status])
  @@index([serviceType])
  @@index([vendorId])
  @@index([createdAt])
}

model MarketplaceOrderDetails {
  id                 String   @id @default(uuid())
  orderId            String   @unique
  vendorInstructions String?
  cutleryIncluded    Boolean  @default(false)
  prepStartedAt      DateTime?
  prepCompletedAt    DateTime?

  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id                  String       @id @default(uuid())
  orderId             String
  catalogItemId       String?
  nameSnapshot        String
  priceKoboSnapshot   Int
  quantity            Int
  specialInstructions String?

  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem         CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ShopForMeDetails {
  id                     String     @id @default(uuid())
  orderId                String     @unique
  shopName               String     // Name of store or market (e.g. "Balogun Market Stall 45", "Ebeano Supermarket Lekki")
  shopAddress            String
  goodsBudgetKobo        Int        // Budget reserved specifically for purchasing goods
  actualGoodsSpentKobo   Int        @default(0) // Actual amount spent from receipt
  spendingLimitKobo      Int        // Max upper bound before hard stop
  substitutionPreference String     @default("CALL_CUSTOMER") // CALL_CUSTOMER, RIDER_DISCRETION, DO_NOT_REPLACE
  receiptPhotoUrl        String?
  reconciliationStatus   String     @default("PENDING") // PENDING, APPROVED_BY_CUSTOMER, RECONCILED, DISPUTED
  customerApprovalRequired Boolean  @default(false)
  customerApprovedAt     DateTime?
  notes                  String?

  order                  Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items                  ShopItem[]
}

model ShopItem {
  id                String           @id @default(uuid())
  shopDetailsId     String
  itemName          String
  estimatedPriceKobo Int             @default(0)
  quantity          Int              @default(1)
  unit              String?          // e.g. "kg", "pack", "crate"
  notes             String?
  isPurchased       Boolean          @default(false)
  actualPriceKobo   Int?
  substitutionNotes String?

  shopDetails       ShopForMeDetails @relation(fields: [shopDetailsId], references: [id], onDelete: Cascade)

  @@index([shopDetailsId])
}

model PackageDetails {
  id                   String   @id @default(uuid())
  orderId              String   @unique
  packageCategory      String   // DOCUMENTS, FOOD_BOX, ELECTRONICS, CLOTHING, PARCEL
  weightKg             Float    @default(1.0)
  dimensionsCm         String?  // e.g. "30x20x15"
  recipientName        String
  recipientPhone       String
  recipientAltPhone    String?
  isFragile            Boolean  @default(false)
  securityPin          String   // 4-digit verification PIN required for drop-off handoff
  deliveryInstructions String?
  proofPhotoUrl        String?

  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Delivery {
  id                       String          @id @default(uuid())
  orderId                  String          @unique
  riderId                  String?
  status                   String          @default("PENDING_DISPATCH") // PENDING_DISPATCH, OFFERED, ACCEPTED, ARRIVED_PICKUP, PICKED_UP, EN_ROUTE_DROPOFF, ARRIVED_DROPOFF, DELIVERED, FAILED, CANCELLED
  pickupTime               DateTime?
  deliveryTime             DateTime?
  estimatedDurationMinutes Int             @default(35)
  distanceKm               Float           @default(5.2)
  proofType                String          @default("PIN_AND_PHOTO") // PIN_AND_PHOTO, PIN_ONLY, PHOTO_ONLY
  proofNotes               String?
  proofPhotoUrl            String?
  verifiedPin              String?
  riderEarningsKobo        Int             @default(0)
  dispatcherNote           String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  order                    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider                    RiderProfile?   @relation(fields: [riderId], references: [id])
  offers                   DispatchOffer[]

  @@index([riderId])
  @@index([status])
}

model DispatchOffer {
  id                    String        @id @default(uuid())
  deliveryId            String
  riderId               String
  status                String        @default("OFFERED") // OFFERED, ACCEPTED, DECLINED, EXPIRED, SUPERSEDED
  offeredAt             DateTime      @default(now())
  expiresAt             DateTime
  respondedAt           DateTime?
  responseReason        String?
  estimatedEarningsKobo Int           @default(0)

  delivery              Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider                 RiderProfile  @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([riderId])
  @@index([status])
}

model Payment {
  id                 String   @id @default(uuid())
  orderId            String   @unique
  amountKobo         Int
  currency           String   @default("NGN")
  provider           String   @default("MOCK_PAYSTACK") // MOCK_PAYSTACK, PAYSTACK, FLUTTERWAVE
  status             String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  providerRef        String?  @unique
  idempotencyKey     String?  @unique
  channel            String   @default("CARD") // CARD, BANK_TRANSFER, USSD, WALLET
  paidAt             DateTime?
  webhookPayloadJson String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([providerRef])
}

model LedgerAccount {
  id          String        @id @default(uuid())
  code        String        @unique // CUSTOMER_WALLET, VENDOR_PAYABLE, RIDER_PAYABLE, PLATFORM_FEES, ESCROW_GOODS, REFUND_CLEARING
  name        String
  balanceKobo Int           @default(0)
  currency    String        @default("NGN")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  debitEntries  LedgerEntry[] @relation("DebitEntries")
  creditEntries LedgerEntry[] @relation("CreditEntries")
}

model LedgerEntry {
  id              String        @id @default(uuid())
  orderId         String?
  debitAccountId  String
  creditAccountId String
  amountKobo      Int
  description     String
  referenceType   String        // ORDER_PAYMENT, VENDOR_PAYOUT, RIDER_EARNING, PLATFORM_COMMISSION, SHOPPING_RECONCILIATION, CUSTOMER_REFUND
  isCompensating  Boolean       @default(false)
  createdAt       DateTime      @default(now())

  debitAccount    LedgerAccount @relation("DebitEntries", fields: [debitAccountId], references: [id])
  creditAccount   LedgerAccount @relation("CreditEntries", fields: [creditAccountId], references: [id])

  @@index([orderId])
  @@index([createdAt])
  @@index([referenceType])
}

model OrderEvent {
  id          String   @id @default(uuid())
  orderId     String
  eventType   String   // STATUS_CHANGE, RIDER_ASSIGNED, RECEIPT_UPLOADED, SUBSTITUTION_REQUESTED, PIN_VERIFIED, EXCEPTION_LOGGED
  actorId     String?
  actorRole   String?
  metadataJson String?
  timestamp   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([timestamp])
}

model SupportCase {
  id              String   @id @default(uuid())
  orderId         String?
  creatorId       String
  assignedToId    String?
  status          String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, CLOSED
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  subject         String
  description     String
  resolutionNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  creator         User     @relation("CreatedSupportCases", fields: [creatorId], references: [id])
  assignedTo      User?    @relation("AssignedSupportCases", fields: [assignedToId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([priority])
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String
  userRole       String
  action         String   // ORDER_REASSIGN, MANUAL_OVERRIDE, REFUND_ISSUED, VENDOR_UPDATE, ZONE_CONFIG, FEE_CHANGE
  targetResource String
  targetId       String
  reason         String
  metadataJson   String?
  ipAddress      String?
  timestamp      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

model Rating {
  id          String        @id @default(uuid())
  orderId     String
  fromUserId  String
  toRiderId   String?
  toVendorId  String?
  score       Int           // 1 to 5
  comment     String?
  createdAt   DateTime      @default(now())

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromUser    User          @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toRider     RiderProfile? @relation(fields: [toRiderId], references: [id])
  toVendor    Vendor?       @relation(fields: [toVendorId], references: [id])

  @@index([orderId])
  @@index([toRiderId])
  @@index([toVendorId])
}
