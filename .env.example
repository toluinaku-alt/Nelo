# Nelo Delivery Platform — Environment Configuration

# Database: In local development, uses SQLite file:./dev.db by default.
# For Supabase PostgreSQL production, replace with your Supabase Transaction Pooler URL (port 6543)
DATABASE_URL="file:./dev.db"

# Direct URL for Supabase migrations (port 5432, session mode)
DIRECT_URL=""

# Supabase Auth, Storage & Realtime
NEXT_PUBLIC_SUPABASE_URL="https://nelo-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5lbG8tcHJvamVjdCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzA0MDY3MjAwfQ.example"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5lbG8tcHJvamVjdCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3MDQwNjcyMDB9.example"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NELO_ENV="development"
MOCK_SERVICES="true"

# Payment Adapter (Mock Paystack / Flutterwave)
# Set MOCK_SERVICES=false and provide real keys for production Paystack integration
PAYSTACK_PUBLIC_KEY="pk_test_nelo_mock_key"
PAYSTACK_SECRET_KEY="sk_test_nelo_mock_key"
PAYSTACK_WEBHOOK_SECRET="whsec_nelo_mock_secret"

# Notifications (Mock SMS/Push adapter)
MOCK_SMS_PROVIDER="true"
MOCK_PUSH_PROVIDER="true"
TERMII_API_KEY=""
AFRICASTALKING_API_KEY=""

# Geo & Maps (Mock Leaflet / OpenStreetMap default; Google Maps or Radar when keys provided)
NEXT_PUBLIC_MAPS_PROVIDER="mock_osm"
GOOGLE_MAPS_API_KEY=""
